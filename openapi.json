{
  "openapi": "3.1.0",
  "info": {
    "title": "Japan Utils — pay-per-request utility APIs for AI agents",
    "version": "0.1.0",
    "description": "Deterministic utility APIs priced per request in Solana USDC via x402: Japanese postal code lookup, holidays/business days (JP/US/DE/FR/GB), wareki conversion, kana-romaji/slug/width text tools, timezone and Unix time conversion, CSV/JSON/unit/FX conversion, QR code generation, web metadata extraction and DNS lookup. Paid operations return HTTP 402 with x402 payment requirements when called without an X-PAYMENT header."
  },
  "servers": [
    {
      "url": "https://japan-utils.example.com"
    }
  ],
  "paths": {
    "/v1/postal": {
      "get": {
        "operationId": "postal_lookup",
        "summary": "Look up Japanese addresses by 7-digit postal code",
        "responses": {
          "200": {
            "description": "Successful response (after x402 payment)"
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "402": {
            "description": "Payment required: x402 PaymentRequirements JSON (Solana USDC)"
          }
        },
        "x-payment-info": {
          "protocols": [
            "x402"
          ],
          "pricingMode": "fixed",
          "price": "0.02",
          "currency": "USD",
          "network": "solana",
          "asset": "USDC"
        },
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "description": "7-digit Japanese postal code; hyphen optional (e.g. 100-0001 or 1000001)",
            "schema": {
              "type": "string"
            },
            "example": "100-0001"
          }
        ]
      }
    },
