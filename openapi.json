                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Hostname to resolve",
                    "example": "example.com"
                  },
                  "type": {
                    "type": "string",
                    "description": "Record type (default A)",
                    "example": "MX"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
